<Window x:Class="VictusControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VICTUS CONTROL"
        Width="448"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="Segoe UI, Segoe UI Variable"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowActivated="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- single compact card (v33-style widget) -->
    <Border Background="{StaticResource Card}" CornerRadius="14" BorderBrush="#232429"
            BorderThickness="1" Margin="8" Padding="18,14,16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: title + live temps + window glyphs (drag zone) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VICTUS CONTROL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="HeaderStatus" Text="" FontSize="10.5" Foreground="{StaticResource TextDim}"
                               Margin="12,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GlyphButton}" Content="&#xE921;" ToolTip="Minimize to tray" Click="Hide_Click" />
                    <Button x:Name="SettingsChevron" Style="{StaticResource GlyphButton}" Content="&#xE70D;" ToolTip="More" Click="Chevron_Click" />
                    <Button Style="{StaticResource GlyphButton}" Content="&#xE8BB;" ToolTip="Exit" Click="Exit_Click" />
                </StackPanel>
            </Grid>

            <!-- profile pills -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock Text="MODE" Style="{StaticResource RowCaption}" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="EcoPill" Style="{StaticResource ModePill}" Content="ECO" Margin="0,0,8,0" Checked="Eco_Checked" />
                    <RadioButton x:Name="BalancedPill" Style="{StaticResource ModePill}" Content="BALANCED" Margin="0,0,8,0" Checked="Balanced_Checked" />
                    <RadioButton x:Name="PerfPill" Style="{StaticResource ModePill}" Content="PERF" Margin="0" Checked="Perf_Checked" />
                </UniformGrid>
            </StackPanel>

            <!-- fan row -->
            <StackPanel x:Name="FanSection" Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="FANS" Style="{StaticResource RowCaption}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="FanAutoPill" Style="{StaticResource SmallPill}" Content="AUTO" Width="56" Checked="FanAuto_Checked" />
                        <RadioButton x:Name="FanMaxPill" Style="{StaticResource SmallPill}" Content="MAX" Width="56" Margin="0" Checked="FanMax_Checked" />
                    </StackPanel>
                    <Slider Grid.Column="1" x:Name="FanSlider" Style="{StaticResource MiniSlider}"
                            Minimum="1" Maximum="100" Value="45" Margin="12,0,10,0" VerticalAlignment="Center"
                            ValueChanged="FanSlider_Changed" />
                    <TextBlock Grid.Column="2" x:Name="FanPercent" Text="45%" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Width="32" TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- footer status -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterNote" Grid.Column="0" Text="" FontSize="9.5"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FanReadout" Grid.Column="1" Text="" FontSize="9.5"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
            </Grid>

            <!-- expandable extra: graphics + settings -->
            <StackPanel x:Name="ExtraPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="GRAPHICS" Style="{StaticResource RowCaption}" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="HybridPill" Style="{StaticResource ModePill}" Content="HYBRID" Height="30" Margin="0,0,8,0" Click="Hybrid_Click" />
                    <RadioButton x:Name="DiscretePill" Style="{StaticResource ModePill}" Content="DISCRETE" Height="30" Margin="0" Click="Discrete_Click" />
                </UniformGrid>
                <TextBlock x:Name="GraphicsNote" Text="applies after reboot" FontSize="9.5"
                           Foreground="{StaticResource TextFaint}" Margin="2,6,0,10" />

                <TextBlock Text="SETTINGS" Style="{StaticResource RowCaption}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="On-screen display" FontSize="11" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="OsdToggle" Style="{StaticResource MiniToggle}" Checked="Osd_Changed" Unchecked="Osd_Changed" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Keep mode alive (75 s)" FontSize="11" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="KeepAliveToggle" Style="{StaticResource MiniToggle}" Checked="KeepAlive_Changed" Unchecked="KeepAlive_Changed" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Start with Windows" FontSize="11" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="AutostartToggle" Style="{StaticResource MiniToggle}" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Start minimized to tray" FontSize="11" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="StartMinimizedToggle" Style="{StaticResource MiniToggle}" Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Close button minimizes to tray" FontSize="11" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" x:Name="CloseToTrayToggle" Style="{StaticResource MiniToggle}" Checked="CloseToTray_Changed" Unchecked="CloseToTray_Changed" />
                </Grid>
            </StackPanel>

            <!-- version line -->
            <TextBlock Grid.Row="5" x:Name="VersionNote" Text="v0.0.2-alpha" FontSize="9"
                       Foreground="{StaticResource TextFaint}" Margin="2,10,0,0" />
        </Grid>
    </Border>
</Window>
